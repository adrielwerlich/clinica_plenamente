rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /feedPosts/{postId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /feedImages/{imageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // TEMPORÁRIO (teste de fumaça do Treino Cognitivo, passo 5): cada usuário grava e lê
    // só o próprio users/{uid}/debug/{doc}. Substituir pelas regras definitivas no passo 8.
    match /users/{uid}/debug/{docId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at', 'appVersion', 'touch', 'uploadedAt']);
    }
  }
}
